POSTGRES_DB=foroia
POSTGRES_USER=foroia
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_LARGA
DATABASE_URL=postgresql+asyncpg://foroia:CAMBIAR_CONTRASENA_LARGA@db:5432/foroia
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_API_BASE=http://api:8000

# Clave privada del proxy y credencial para crear la cuenta administradora local.
# Token de >=32 caracteres aleatorios compartido solo entre web y api: python -c "import secrets;print(secrets.token_urlsafe(48))"
EDITORIAL_API_TOKEN=
# Contraseña de >=12 caracteres. Usar solo con HTTPS fuera de localhost.
EDITORIAL_PASSWORD=

# Cuenta administradora local: se crea explícitamente con python -m app.manage bootstrap.
BOOTSTRAP_EMAIL=editor@localhost.test
# true únicamente al servir mediante HTTPS en producción.
COOKIE_SECURE=false
# Desarrollo local con Mailpit. En produccion, false hasta probar SMTP real.
REGISTRATION_ENABLED=true

# Investigación diaria: la clave solo se introduce aquí en el .env local, nunca en el navegador.
OPENAI_API_KEY=
RESEARCH_MODEL=gpt-5-mini
RESEARCH_AT=22:30
RESEARCH_AUTO_PUBLISH=true
RESEARCH_TWO_LANES=false
RESEARCH_PRACTICAL_PUBLICATIONS=1
# Límite autorizado: como máximo 5 USD/mes. Reserva conservadora, no factura real.
RESEARCH_MONTHLY_USD=5
RESEARCH_DAILY_USD=0.15
# Tarifas USD por millón de tokens; comprobarlas al cambiar de modelo/precio.
RESEARCH_INPUT_USD_PER_MILLION=0.25
RESEARCH_OUTPUT_USD_PER_MILLION=2

# Search Console HTML verification; optional GA4 disabled until legal texts and consent are ready.
GOOGLE_SITE_VERIFICATION=
GA4_ID=
ANALYTICS_ENABLED=false
ADSENSE_PUBLISHER_ID=
