foroiaaldia.com {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=15552000"
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    request_body {
        max_size 300KB
    }
    @maintenance expression `{$SITE_MAINTENANCE:true} == true`
    handle @maintenance {
        header X-Robots-Tag "noindex, nofollow"
        header Cache-Control no-store
        header Retry-After 3600
        respond "Foro IA al Día. Estamos preparando la web. Vuelve más tarde." 503
    }
    handle {
        reverse_proxy web:3000 {
            # Sobrescribir siempre el valor que envie un visitante.
            header_up X-ForoIA-Client-IP {remote_host}
        }
    }
}

# Resolve the HTTP www variant in one hop instead of HTTP -> HTTPS www -> apex.
http://www.foroiaaldia.com {
    redir https://foroiaaldia.com{uri} permanent
}

www.foroiaaldia.com {
    redir https://foroiaaldia.com{uri} permanent
}
