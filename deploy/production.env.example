# Copiar en el servidor a /opt/foroia/production.env, permisos 600.
# Nunca reutilizar el .env local ni copiar usuarios o sesiones de pruebas.
POSTGRES_PASSWORD=
# Usar contrasena hexadecimal para evitar problemas de escape en la URL.
DATABASE_URL=postgresql+asyncpg://foroia:PASSWORD@db:5432/foroia
EDITORIAL_API_TOKEN=
BOOTSTRAP_EMAIL=admin@foroiaaldia.com
BOOTSTRAP_PASSWORD=
SITE_MAINTENANCE=true
REGISTRATION_ENABLED=false
ACCOUNT_EMAIL_ENABLED=false
# Activar solo tras migracion 0010, recibos verificados y aprobacion del despliegue.
RESEARCH_TWO_LANES=false
RESEARCH_PRACTICAL_PUBLICATIONS=1
# Datos publicos solo despues de autorizarlos el titular. No usar datos de factura.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_TAX_ID=

# MX Plan Redirect no es un buzon ni un servidor SMTP de envio.
# La redireccion de admin al correo personal se configura en OVHcloud.
# Configurar correo transaccional STARTTLS 587 y verificar entrega real
# antes de cambiar REGISTRATION_ENABLED a true.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=Foro IA al Día <admin@foroiaaldia.com>
SMTP_USER=
SMTP_PASSWORD=

# Dejar vacio hasta desactivar el trabajador local, contabilizar el gasto
# previo del mes y comprobar backup/restauracion. Perfil research opt-in.
OPENAI_API_KEY=

# Search Console HTML verification; optional GA4 disabled until legal texts and consent are ready.
GOOGLE_SITE_VERIFICATION=
GA4_ID=
ANALYTICS_ENABLED=false
ADSENSE_PUBLISHER_ID=
